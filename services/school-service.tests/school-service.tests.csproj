<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <IsTestProject>true</IsTestProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit" Version="2.7.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.4">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.9.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Read by NotificationTenancyTests, which checks that every notification statement names the school. -->
    <None Include="../school-service/Suite.Notification*.cs;../school-service/Suite.Attendance.cs;../school-service/Suite.Homework.cs;../school-service/Suite.Exams.cs;../school-service/Suite.Student360.cs;../school-service/Suite.Fees.cs;../school-service/Suite.Timetable.cs;../school-service/Suite.Leave.cs;../school-service/FeesSchema.sql;../school-service/NotificationSchema.sql;../school-service/AttendanceSchema.sql" Link="Sources/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../school-service/school-service.csproj" />
  </ItemGroup>

</Project>
