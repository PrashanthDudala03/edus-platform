{
  "Serilog": {
    "MinimumLevel": "Information",
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/gateway-.txt",
          "rollingInterval": "Day"
        }
      }
    ]
  },
  "ReverseProxy": {
    "Routes": {
      "auth_route": {
        "ClusterId": "auth_cluster",
        "Match": {
          "Path": "/api/v1/auth/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/api/auth/{**catch-all}"
          }
        ]
      },
      "users_route": {
        "ClusterId": "auth_cluster",
        "AuthorizationPolicy": "EduOSAdministrators",
        "Match": {
          "Path": "/api/v1/users/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/api/users/{**catch-all}"
          }
        ]
      },
      "roles_route": {
        "ClusterId": "auth_cluster",
        "AuthorizationPolicy": "EduOSAdministrators",
        "Match": {
          "Path": "/api/v1/roles/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/api/roles/{**catch-all}"
          }
        ]
      },
      "students_route": {
        "ClusterId": "students_cluster",
        "AuthorizationPolicy": "EduOSAdministrators",
        "Match": {
          "Path": "/api/v1/students/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/api/students/{**catch-all}"
          }
        ]
      },
      "teachers_route": {
        "ClusterId": "teachers_cluster",
        "AuthorizationPolicy": "EduOSAdministrators",
        "Match": {
          "Path": "/api/v1/teachers/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/api/teachers/{**catch-all}"
          }
        ]
      },
      "parents_route": {
        "ClusterId": "parents_cluster",
        "AuthorizationPolicy": "EduOSAdministrators",
        "Match": {
          "Path": "/api/v1/parents/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/api/parents/{**catch-all}"
          }
        ]
      },
      "schools_route": {
        "ClusterId": "schools_cluster",
        "AuthorizationPolicy": "EduOSAdministrators",
        "Match": {
          "Path": "/api/v1/schools/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/api/schools/{**catch-all}"
          }
        ]
      },
      "auth_login_route": {
        "ClusterId": "auth_cluster",
        "AuthorizationPolicy": "Anonymous",
        "Order": 0,
        "Match": {
          "Path": "/api/v1/auth/login"
        },
        "Transforms": [
          {
            "PathPattern": "/api/auth/login"
          }
        ]
      },
      "auth_refresh_route": {
        "ClusterId": "auth_cluster",
        "AuthorizationPolicy": "Anonymous",
        "Order": 0,
        "Match": {
          "Path": "/api/v1/auth/refresh"
        },
        "Transforms": [
          {
            "PathPattern": "/api/auth/refresh"
          }
        ]
      },
      "operations_route": {
        "ClusterId": "schools_cluster",
        "AuthorizationPolicy": "EduOSLeadership",
        "Match": {
          "Path": "/api/v1/operations/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/api/operations/{**catch-all}"
          }
        ]
      },
      "suite_route": {
        "ClusterId": "schools_cluster",
        "AuthorizationPolicy": "EduOSSuite",
        "Match": {
          "Path": "/api/v1/suite/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/api/suite/{**catch-all}"
          }
        ]
      },
      "auth_reset_route": {
        "ClusterId": "auth_cluster",
        "AuthorizationPolicy": "Anonymous",
        "Order": 0,
        "Match": {
          "Path": "/api/v1/auth/reset-password"
        },
        "Transforms": [
          {
            "PathPattern": "/api/auth/reset-password"
          }
        ]
      },
      "students_read_route": {
        "ClusterId": "students_cluster",
        "AuthorizationPolicy": "EduOSLeadership",
        "Order": -1,
        "Match": {
          "Path": "/api/v1/students/{**catch-all}",
          "Methods": [
            "GET"
          ]
        },
        "Transforms": [
          {
            "PathPattern": "/api/students/{**catch-all}"
          }
        ]
      },
      "teachers_read_route": {
        "ClusterId": "teachers_cluster",
        "AuthorizationPolicy": "EduOSLeadership",
        "Order": -1,
        "Match": {
          "Path": "/api/v1/teachers/{**catch-all}",
          "Methods": [
            "GET"
          ]
        },
        "Transforms": [
          {
            "PathPattern": "/api/teachers/{**catch-all}"
          }
        ]
      },
      "parents_read_route": {
        "ClusterId": "parents_cluster",
        "AuthorizationPolicy": "EduOSLeadership",
        "Order": -1,
        "Match": {
          "Path": "/api/v1/parents/{**catch-all}",
          "Methods": [
            "GET"
          ]
        },
        "Transforms": [
          {
            "PathPattern": "/api/parents/{**catch-all}"
          }
        ]
      },
      "schools_read_route": {
        "ClusterId": "schools_cluster",
        "AuthorizationPolicy": "EduOSLeadership",
        "Order": -1,
        "Match": {
          "Path": "/api/v1/schools/{**catch-all}",
          "Methods": [
            "GET"
          ]
        },
        "Transforms": [
          {
            "PathPattern": "/api/schools/{**catch-all}"
          }
        ]
      },
      "platform_route": {
        "ClusterId": "auth_cluster",
        "AuthorizationPolicy": "EduOSPlatform",
        "Match": {
          "Path": "/api/v1/platform/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/api/platform/{**catch-all}"
          }
        ]
      },
      "billing_webhook_route": {
        "ClusterId": "auth_cluster",
        "AuthorizationPolicy": "Anonymous",
        "Order": -3,
        "Match": {
          "Path": "/api/v1/billing/webhooks/razorpay",
          "Methods": [ "POST" ]
        },
        "Transforms": [
          {
            "PathPattern": "/api/billing/webhooks/razorpay"
          }
        ]
      },
      "promotions_route": {
        "ClusterId": "auth_cluster",
        "AuthorizationPolicy": "Anonymous",
        "Order": -3,
        "Match": {
          "Path": "/api/v1/promotions",
          "Methods": [ "GET" ]
        },
        "Transforms": [
          {
            "PathPattern": "/api/promotions"
          }
        ]
      },
      "billing_route": {
        "ClusterId": "auth_cluster",
        "AuthorizationPolicy": "EduOSPlatform",
        "Order": -2,
        "Match": {
          "Path": "/api/v1/billing/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/api/billing/{**catch-all}"
          }
        ]
      },
      "subscription_route": {
        "ClusterId": "auth_cluster",
        "AuthorizationPolicy": "EduOSAnyRole",
        "Order": -2,
        "Match": {
          "Path": "/api/v1/subscription/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/api/subscription/{**catch-all}"
          }
        ]
      },
      "ai_route": {
        "ClusterId": "ai_cluster",
        "AuthorizationPolicy": "EduOSAnyRole",
        "Order": -2,
        "Match": {
          "Path": "/api/v1/ai/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/api/ai/{**catch-all}"
          }
        ]
      },
      "control_route": {
        "ClusterId": "auth_cluster",
        "AuthorizationPolicy": "EduOSAnyRole",
        "Order": -2,
        "Match": {
          "Path": "/api/v1/control/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/api/control/{**catch-all}"
          }
        ]
      },
      "auth_signup_route": {
        "ClusterId": "auth_cluster",
        "AuthorizationPolicy": "Anonymous",
        "Order": -2,
        "Match": {
          "Path": "/api/v1/auth/signup"
        },
        "Transforms": [
          {
            "PathPattern": "/api/auth/signup"
          }
        ]
      }
    },
    "Clusters": {
      "auth_cluster": {
        "Destinations": {
          "auth_destination": {
            "Address": "http://auth-service:6001"
          }
        }
      },
      "students_cluster": {
        "Destinations": {
          "students_destination": {
            "Address": "http://student-service:6002"
          }
        }
      },
      "teachers_cluster": {
        "Destinations": {
          "teachers_destination": {
            "Address": "http://teacher-service:6003"
          }
        }
      },
      "parents_cluster": {
        "Destinations": {
          "parents_destination": {
            "Address": "http://parent-service:6004"
          }
        }
      },
      "schools_cluster": {
        "Destinations": {
          "schools_destination": {
            "Address": "http://school-service:6005"
          }
        }
      },
      "ai_cluster": {
        "Destinations": {
          "ai_destination": {
            "Address": "http://ai-service:6006"
          }
        }
      }
    }
  }
}
