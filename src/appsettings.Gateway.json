{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "System": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/api/auth{**remainder}"
        },
        "Transforms": [
          {
            "PathPattern": "/api/auth{**remainder}",
            "PathReplace": "/{**remainder}"
          }
        ]
      },
      "students-route": {
        "ClusterId": "students-cluster",
        "Match": {
          "Path": "/api/students{**remainder}"
        },
        "Transforms": [
          {
            "PathPattern": "/api/students{**remainder}",
            "PathReplace": "/students{**remainder}"
          }
        ]
      },
      "teachers-route": {
        "ClusterId": "teachers-cluster",
        "Match": {
          "Path": "/api/teachers{**remainder}"
        },
        "Transforms": [
          {
            "PathPattern": "/api/teachers{**remainder}",
            "PathReplace": "/teachers{**remainder}"
          }
        ]
      },
      "parents-route": {
        "ClusterId": "parents-cluster",
        "Match": {
          "Path": "/api/parents{**remainder}"
        },
        "Transforms": [
          {
            "PathPattern": "/api/parents{**remainder}",
            "PathReplace": "/parents{**remainder}"
          }
        ]
      }
    },
    "Clusters": {
      "auth-cluster": {
        "Destinations": {
          "auth-service": {
            "Address": "http://auth-service:5001"
          }
        }
      },
      "students-cluster": {
        "Destinations": {
          "student-service": {
            "Address": "http://student-service:5002"
          }
        }
      },
      "teachers-cluster": {
        "Destinations": {
          "teacher-service": {
            "Address": "http://teacher-service:5003"
          }
        }
      },
      "parents-cluster": {
        "Destinations": {
          "parent-service": {
            "Address": "http://parent-service:5004"
          }
        }
      }
    }
  }
}
