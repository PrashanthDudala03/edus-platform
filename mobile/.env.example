# Address of the existing EduOS API Gateway, including /api/v1. Copy this file to .env and set it for your machine.
# It is a public address, not a secret: everything prefixed EXPO_PUBLIC_ is compiled into the app.
# A phone cannot reach "localhost". Use an HTTPS address the phone can open, for example the ngrok tunnel:
EXPO_PUBLIC_API_URL=https://your-tunnel.ngrok-free.dev/api/v1
